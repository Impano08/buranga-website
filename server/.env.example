# ---------------------------------------------------------------------------
# BURANGA server environment variables
# Copy this file to ".env" and adjust the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Port for the API server
PORT=5050

# Frontend address (used for CORS and password-reset links)
CLIENT_URL=http://localhost:5175

# MongoDB connection string
# Local MongoDB:  mongodb://127.0.0.1:27017/buranga
# MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/buranga
MONGO_URI=mongodb://127.0.0.1:27017/buranga

# Secret used to sign session tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- OPTIONAL: Cloudinary image hosting -----------------------------------
# Without these, photos are stored locally in server/uploads/ (fine for dev).
# Create a free account at https://cloudinary.com and copy the values from
# your dashboard ("API Key" / "API Secret" / cloud name).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OPTIONAL: real password-reset emails (nodemailer + SMTP) --------------
# Without these, password-reset links are printed to the backend console and
# returned in the API response while NODE_ENV is not "production".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BURANGA <no-reply@buranga.local>

# Pexels API key (https://www.pexels.com/api/) - required for harvest-pexels.mjs
PEXELS_API_KEY=
